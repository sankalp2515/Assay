# Copy to backend/.env. Never commit this file with real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Sandbox only. Production PayPal hosts are deliberately unsupported in this build.
PAYPAL_RETURN_URL=http://localhost:4100/v1/paypal/return
PAYPAL_CANCEL_URL=http://localhost:4100/v1/paypal/cancel
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini primary. Optional independently configured API fallbacks, in this order.
AI_FALLBACK_PROVIDERS=groq,nvidia
AI_ZERO_COST_ONLY=true
# Set true only after checking this provider project's free tier and billing controls.
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_FREE_TIER_CONFIRMED=false
NVIDIA_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
MAX_AI_ASSESSMENTS_PER_DAY=50
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4.5
# Real paid inference is opt-in, independently capped. Existing tasks can be inspected.
ALLOW_PAID_INFERENCE=false
MAX_PROVIDER_ATTEMPTS=1
RUNWAY_ALLOWED_HOSTS=api.dev.runwayml.com,dnznrvs05pmza.cloudfront.net
MEDIA_VERIFIER_URL=
MEDIA_VERIFIER_TOKEN=
# Optional evidence search. PostgreSQL remains the financial source of truth.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Deployment-only. Local runner provisions isolated persistent development databases.
DATABASE_URL=
SERVICE_NAME=commerce
PORT=4100
PUBLIC_ORIGIN=http://localhost:4100
# Deployment provisioning supplies SERVICE_PRIVATE_KEY, PUBLIC_KEYS and SERVICE_URLS.
# They are generated locally by npm run provision and are never checked in.
