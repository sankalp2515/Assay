# Copy to backend/.env. Never commit this file with real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Sandbox only. Production PayPal hosts are deliberately unsupported in this build.
PAYPAL_RETURN_URL=http://localhost:4100/v1/paypal/return
PAYPAL_CANCEL_URL=http://localhost:4100/v1/paypal/cancel
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini primary. Optional independently configured API fallbacks, in this order.
AI_FALLBACK_PROVIDERS=groq,nvidia
AI_ZERO_COST_ONLY=true
# Set true only after checking this provider project's free tier and billing controls.
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_FREE_TIER_CONFIRMED=false
NVIDIA_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
MAX_AI_ASSESSMENTS_PER_DAY=50
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4.5
# Real paid inference is opt-in, independently capped. Existing tasks can be inspected.
ALLOW_PAID_INFERENCE=false
MAX_PROVIDER_ATTEMPTS=1
RUNWAY_ALLOWED_HOSTS=api.dev.runwayml.com,dnznrvs05pmza.cloudfront.net
# Merchants on Replicate: lookup-only with the merchant's own token. Assay never generates there.
REPLICATE_API_TOKEN=
REPLICATE_ALLOWED_HOSTS=replicate.delivery
# Any other provider (fal, Veo, Luma, self-hosted): exact hosts the merchant's reported
# output URLs may come from. Empty means reported tasks are refused.
REPORTED_OUTPUT_HOSTS=
# Exact-amount approval window in seconds (30-600, default 45).
APPROVAL_WINDOW_SECONDS=45
# Frontend origin the buyer returns to after PayPal approval or cancel (303 to
# <base>/#/buyer/<batch>/agreement). https, or http on loopback. Empty keeps the JSON page.
BUYER_RETURN_BASE=http://localhost:5180
# Watch registered tasks and archive output as soon as it finishes (default true).
AUTO_ARCHIVE_TASKS=true
# Signed events to the merchant's system (clip.recovered, batch.settled, batch.voided).
# https only (http allowed for localhost). Secret: at least 32 random characters.
MERCHANT_WEBHOOK_URL=
MERCHANT_WEBHOOK_SECRET=
MEDIA_VERIFIER_URL=
MEDIA_VERIFIER_TOKEN=
# Optional evidence search. PostgreSQL remains the financial source of truth.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Deployment-only. Local runner provisions isolated persistent development databases.
DATABASE_URL=
SERVICE_NAME=commerce
PORT=4100
PUBLIC_ORIGIN=http://localhost:4100
# Deployment provisioning supplies SERVICE_PRIVATE_KEY, PUBLIC_KEYS and SERVICE_URLS.
# They are generated locally by npm run provision and are never checked in.

# ---- Merchant platform (12 November 2026) ----
# Self-serve sign-up: closed (default), invite (needs SIGNUP_INVITE_CODE, 12+ chars) or
# open (hosted Sandbox demo only).
SIGNUP_MODE=closed
SIGNUP_INVITE_CODE=
# Each merchant connects their own PayPal account through partner onboarding. Leave false
# until this PayPal app is approved as a partner; tenants then use PAYPAL_MERCHANT_ID.
PAYPAL_PARTNER_MODE=false
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Archived originals: local (a private volume) or gcs (a private Google Cloud Storage
# bucket; on Google Cloud the VM or Cloud Run service account is used, no key file).
ARTIFACT_STORE=local
GCS_BUCKET=
GCS_PREFIX=artifacts/
# Gemini through Vertex AI spends the Google Cloud project's credits (AI Studio keys
# cannot). Off unless VERTEX_CREDITS_CONFIRMED=true. AI_PRIMARY=vertex puts it first;
# otherwise list "vertex" in AI_FALLBACK_PROVIDERS to use it only when the free key fails.
AI_PRIMARY=gemini
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=
VERTEX_CREDITS_CONFIRMED=false
# Sign-up limit per address per hour at Commerce (the web gateway also limits per visitor).
SIGNUP_RATE_PER_HOUR=5
# Hosted Sandbox demo only: a demo provider that reports DEMO_CLIP_URL (a public test clip
# whose host is in REPORTED_OUTPUT_HOSTS) for each unit of an authorized batch.
DEMO_SIMULATOR=false
DEMO_CLIP_URL=
# External playback proof (KERNEL): after delivery or recovery, a cloud Chromium fetches
# the clip from the public buyer route, checks its SHA-256 and plays it, with a replay.
# PLAYBACK_PROBE_ORIGIN is this deployment's public https origin. Never on the money path.
KERNEL_API_KEY=
PLAYBACK_PROBE_ORIGIN=
KERNEL_MAX_PROBES_PER_DAY=40
